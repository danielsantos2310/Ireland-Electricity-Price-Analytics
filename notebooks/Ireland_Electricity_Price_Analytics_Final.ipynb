    "print(\"Project:\", PROJECT_DIR)\n",
    "print(\"Raw data:\", RAW_DIR)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "b3bfea5a",
   "metadata": {},
   "outputs": [],
   "source": [
    "electricity = pd.read_csv(RAW_DIR / \"seai_business_electricity_biannual_2008_2025.csv\")\n",
    "gas = pd.read_csv(RAW_DIR / \"seai_business_gas_biannual_2008_2025.csv\")\n",
    "quarterly_fuels = pd.read_csv(RAW_DIR / \"seai_commercial_fuel_cost_quarterly_2008_2025.csv\")\n",
    "bands_2025s2 = pd.read_csv(RAW_DIR / \"seai_business_electricity_bands_2025S2.csv\")\n",
    "\n",
    "display(electricity.head())\n",
    "display(bands_2025s2)\n"
   ]
