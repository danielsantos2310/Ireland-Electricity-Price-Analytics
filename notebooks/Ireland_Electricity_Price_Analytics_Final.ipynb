   "metadata": {},
   "outputs": [],
   "source": [
    "fig, ax = plt.subplots(figsize=(11, 5.5))\n",
    "ax.plot(prices[\"period\"], prices[\"electricity_ie_c_per_kwh\"], marker=\"o\", linewidth=2)\n",
    "ax.set_title(\"Ireland business electricity price, 2008–2025\")\n",
